{
  "name": "movie-vault-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaulAtkins88/MovieVaultBridge.git"
  },
  "homepage": "https://paulatkins88.github.io/MovieVaultBridge/",
  "bugs": {
    "url": "https://github.com/PaulAtkins88/MovieVaultBridge/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm-run-all --parallel dev:*",
    "dev:server": "npm run dev --workspace @movie-vault-bridge/server",
    "dev:web": "npm run dev --workspace @movie-vault-bridge/web",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
